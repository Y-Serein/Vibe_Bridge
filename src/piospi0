.program piospi0
.side_set 1

.wrap_target

    pull    block           side 0
    mov     x, osr          side 0

    pull    block           side 0
    mov     y, osr          side 0
    pull    block           side 0

    set     pins, 1         side 1 [1]
    nop                     side 0

pre_clk:
    nop                     side 1
    nop                     side 1
    nop                     side 0
    jmp     x-- pre_clk     side 0

send_bits:
    pull    ifempty         side 0
    out     pins, 1         side 0
    nop                     side 1
    jmp     y-- send_bits   side 1

    set     pins, 0         side 0

.wrap

