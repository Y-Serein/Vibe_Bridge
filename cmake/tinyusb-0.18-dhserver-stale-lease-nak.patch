+				ip_addr_t destination;
+				ip_addr_set_ip4_u32(&destination, requested_ip.addr);
+				udp_sendto(upcb, pp, &destination, port);
+			} else {
+				udp_sendto(upcb, pp, IP_ADDR_BROADCAST, port);
+			}
 			pbuf_free(pp);
 			break;
 
